pipeline {
    agent any

    parameters {
        //string(name: 'Int_Freq_tool', description: 'To select only one tool', defaultValue: 'CONTROLFREEC_20000')
        string(name: 'TASK_ID', defaultValue: 'test')
        string(name: 'EXPERIMENT_LIST', defaultValue: 'HCC1395BL')
        extendedChoice(description: 'Analysis type', multiSelectDelimiter: ',', name: 'ANALYSIS_TYPE', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_RADIO', value: 'germline, tumor_nromal, tumor_only', visibleItemCount: 3, defaultValue: 'germline')
        booleanParam(name: 'RUN', defaultValue: true)
    }

    environment {
        HPC_DIRECTORY = '/home/groups/dat/jdieguez/AMANDA/work_dir'
    }

    stages {
        stage('Checkout Omicsloader repo') {
            steps {
                git(url: 'https://github.com/bag-cnag/sarek_plus_germline_dry.git', branch: 'amanda_plus_tests', credentialsId: 'joel_github_3')
            }
        }

        stage('Run?') {
            steps {
                script {
                    if !(params.RUN) {
                        params.ANALYSIS_TYPE = ''
                        echo "RUN = False -> Do not run any pipeline."
                    }
                }
                echo "Selected ANALYSIS_TYPE: ${params.ANALYSIS_TYPE}"
            }
        }

        stage('Execution') {
            //when {
            //    expression {env.RUN.toBoolean()}
            //}
            steps {
                withCredentials([file(credentialsId: 'joel_ssh_file2', variable: 'id_hpc')]) {
                    sh '''
                        ssh -i $id_hpc -p 2222 jdieguez@login7.hpc.cnag.eu "source /home/groups/dat/jdieguez/.bash_profile;
                                                                module purge;
                                                                module use /software/dat/modules/all;
                                                                module load Nextflow/22.10.1;
                                                                cd ${HPC_DIRECTORY};
                                                                nextflow run spark_config/data_annotations.nf -c spark_config/nextflow.config --path ${HPC_DIRECTORY}/spark_config -with-report ${HPC_DIRECTORY}/report.html --analysis_type ${ANALYSIS_TYPE} --task_id ${TASK_ID} --working_dir ${HPC_DIRECTORY} --experiment_list ${EXPERIMENT_LIST} --config_dir ${HPC_DIRECTORY}/spark_config
                                                                "
                       '''
                }
            }
        }
    }
}